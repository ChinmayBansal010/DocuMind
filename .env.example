# Neon database and authentication
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Application
DOCUMIND_DATA_DIR=data
MAX_UPLOAD_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=120
API_RATE_LIMIT=120/minute
DOCUMENT_ENCRYPTION_KEY=

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# Azure AI Language
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_API_VERSION=2023-04-01

# Azure AI Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_API_VERSION=3.0

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY=4

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=documind-contracts-v2
AZURE_SEARCH_API_VERSION=2024-07-01
AZURE_SEARCH_VECTOR_DIMENSIONS=768
